{
  "manifest_version": 3,
  "name": "Skreeen — Light & Dark Screenshots",
  "version": "1.0.0",
  "description": "Capture a zone or the full window twice: once in light mode, once in dark mode. Auto-detects how each site switches themes.",
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "debugger",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Skreeen — Light & Dark Screenshots",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture-area": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture a selected zone (light + dark)"
    },
    "capture-full": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Capture the full window (light + dark)"
    }
  }
}
